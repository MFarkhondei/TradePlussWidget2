<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_wallet" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="آخرین بروزرسانی"
                    android:textColor="@color/gray_text"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tvUpdatedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="@color/gray_text"
                    android:textSize="10sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Total assets card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="14dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/circle_wallet_bg">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_wallet" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ارزش کل دارایی"
                    android:textColor="@color/gray_text"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvTotalAssets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/gold"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تومان"
                    android:textColor="@color/gray_text"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_line"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سود و زیان روزانه"
                    android:textColor="@color/gray_text"
                    android:textSize="10sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">
                    <ImageView
                        android:id="@+id/ivProfitArrow"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_down" />
                    <TextView
                        android:id="@+id/tvDailyProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="0"
                        android:textColor="@color/red"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مجموع خرید روزانه"
                    android:textColor="@color/gray_text"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvDailyBuy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Trend chart card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="12dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="روند ۷ روزه (ارزش سبد)"
            android:textColor="@color/gold"
            android:textSize="11sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/ivChart"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitXY" />
    </LinearLayout>

    <!-- Assets list card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="دارایی‌ها"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/rowAsset1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/circle_coin_bg">
                <TextView android:id="@+id/tvSymbol1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="?" android:textColor="@color/navy_dark" android:textSize="11sp" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:id="@+id/tvName1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" />
            <TextView android:id="@+id/tvValue1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPercent1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/badge_down_bg" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="0%" android:textColor="@color/red" android:textSize="10sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/divider_line" />

        <LinearLayout
            android:id="@+id/rowAsset2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/circle_coin_bg">
                <TextView android:id="@+id/tvSymbol2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="?" android:textColor="@color/navy_dark" android:textSize="11sp" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:id="@+id/tvName2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" />
            <TextView android:id="@+id/tvValue2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPercent2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/badge_down_bg" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="0%" android:textColor="@color/red" android:textSize="10sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/divider_line" />

        <LinearLayout
            android:id="@+id/rowAsset3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/circle_coin_bg">
                <TextView android:id="@+id/tvSymbol3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="?" android:textColor="@color/navy_dark" android:textSize="11sp" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:id="@+id/tvName3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" />
            <TextView android:id="@+id/tvValue3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPercent3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/badge_down_bg" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="0%" android:textColor="@color/red" android:textSize="10sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/divider_line" />

        <LinearLayout
            android:id="@+id/rowAsset4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/circle_coin_bg">
                <TextView android:id="@+id/tvSymbol4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="?" android:textColor="@color/navy_dark" android:textSize="11sp" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:id="@+id/tvName4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" />
            <TextView android:id="@+id/tvValue4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPercent4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/badge_down_bg" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="0%" android:textColor="@color/red" android:textSize="10sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/divider_line" />

        <LinearLayout
            android:id="@+id/rowAsset5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/circle_coin_bg">
                <TextView android:id="@+id/tvSymbol5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="?" android:textColor="@color/navy_dark" android:textSize="11sp" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:id="@+id/tvName5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" />
            <TextView android:id="@+id/tvValue5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="-" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPercent5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/badge_down_bg" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="0%" android:textColor="@color/red" android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="تمام مقادیر به تومان می‌باشند"
            android:textColor="@color/gray_text_dim"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
